{
  "name": "amazon-account-detector",
  "description": "Chrome MV3 extension that detects which Amazon account is logged in on a chosen marketplace",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:assoc-handles": "tsx scripts/verify-assoc-handles.ts",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "only-allow": "^1.2.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.1.5",
    "vitest": "^5.0.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
